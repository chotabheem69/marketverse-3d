# Worker proxy URL
# Deploy the Cloudflare Worker and set its URL here
# For local development, use: http://localhost:8787
# For production, use: https://your-worker.your-subdomain.workers.dev
VITE_WORKER_URL=http://localhost:8787

# Optional: Finnhub API key (for additional US stock data)
# Get free key at: https://finnhub.io/
# NEVER commit actual keys - only put them in .env (not .env.example)
# VITE_FINNHUB_KEY=your_key_here

# Optional: Twelve Data API key
# Get free key at: https://twelvedata.com/
# VITE_TWELVE_DATA_KEY=your_key_here
